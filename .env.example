# ============================================================================
# VIJETHA DIGITAL - ENVIRONMENT VARIABLES
# Copy this to .env and fill in your actual values
# ============================================================================

# ========== APPLICATION ==========
APP_NAME=Vijetha Digital Backend
ENV=production

# ========== DATABASE (REQUIRED) ==========
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/vijetha_db

# ========== FRONTEND URL (CORS) ==========
FRONTEND_URL=http://localhost:5173

# ========== JWT CONFIGURATION ==========
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ========== ADMIN BOOTSTRAP (Initial Setup) ==========
ADMIN_EMAIL=admin@vijetha.com
ADMIN_PASSWORD=secure-admin-password-change-this

# First admin (preferred over ADMIN_* above)
FIRST_ADMIN_EMAIL=admin@vijetha.com
FIRST_ADMIN_PASSWORD=secure-admin-password-change-this
FIRST_ADMIN_NAME=Super Admin

# ========== IAM - SECURITY ==========
# Maximum number of concurrent sessions per user
MAX_SESSIONS_PER_USER=5

# Require MFA for admin accounts
REQUIRE_MFA_FOR_ADMIN=true

# Session timeout in minutes (0 = no timeout)
SESSION_TIMEOUT_MINUTES=60

# Password policy
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL_CHARS=true

# Account lockout after failed attempts
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Password expiry (0 = never expires)
PASSWORD_EXPIRY_DAYS=90

# ========== AUDIT & LOGGING ==========
# Log sensitive permission access (user, order, payment modifications)
LOG_PERMISSION_ACCESS=true

# Log all admin actions
LOG_ADMIN_ACTIONS=true

# Log API access with detailed request/response
LOG_API_DETAILED=false

# ========== OAUTH & EXTERNAL AUTH (Optional) ==========
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ========== CLOUDINARY (Media Upload) ==========
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ========== RAZORPAY (Payment Gateway) ==========
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=YOUR_SECRET_KEY
RAZORPAY_WEBHOOK_SECRET=webhook_secret

# ========== EMAIL CONFIGURATION ==========
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_EMAIL=noreply@vijetha.com
SMTP_FROM_NAME=Vijetha Digital

# Email verification
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_TIMEOUT_HOURS=24

# ========== SMS CONFIGURATION (Optional) ==========
SMS_PROVIDER=twilio  # options: twilio, aws_sns
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ========== RATE LIMITING ==========
# Rate limit for auth endpoints (requests per minute)
RATE_LIMIT_AUTH=10

# Rate limit for pricing endpoint
RATE_LIMIT_PRICING=30

# Rate limit for API generally
RATE_LIMIT_API=100

# ========== CORS & SECURITY ==========
# allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Enable HTTPS only cookies
SECURE_COOKIES=false

# CORS allow credentials
CORS_ALLOW_CREDENTIALS=true

# ========== REDIS (Optional - for caching and sessions) ==========
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# ========== AI/ML FEATURES (Optional) ==========
ENABLE_ANALYTICS=true
ENABLE_RECOMMENDATIONS=false

# ========== FILE UPLOAD ==========
MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,tiff,ai,psd,eps,cdr
UPLOAD_DIR=uploads

# ========== BUSINESS RULES ==========
GST_PERCENTAGE=18.0
MIN_ORDER_AMOUNT=100.0
MAX_FILE_SIZE_MB=50

# ========== MONITORING & OBSERVABILITY (Optional) ==========
SENTRY_DSN=
LOG_LEVEL=INFO
ENABLE_PROMETHEUS=false

# ========== FEATURE FLAGS ==========
ENABLE_TWO_FACTOR_AUTH=true
ENABLE_INVITE_SYSTEM=true
ENABLE_CUSTOM_ROLES=true
ENABLE_ROLE_EXPIRY=true
ENABLE_PERMISSION_AUDIT_LOG=true
