# ============================================================================
# VIJETHA DIGITAL - ENVIRONMENT VARIABLES TEMPLATE
# Copy this to .env and fill in your actual values
# NEVER commit .env file to version control
# ============================================================================

# ========== APPLICATION ==========
APP_NAME=Vijetha Digital Backend
ENV=production

# ========== DATABASE (REQUIRED) ==========
DATABASE_URL=

# ========== FRONTEND URL (CORS) ==========
FRONTEND_URL=

# ========== JWT CONFIGURATION (REQUIRED) ==========
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ========== ADMIN BOOTSTRAP (REQUIRED) ==========
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ========== CLOUDINARY (REQUIRED) ==========
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ========== RAZORPAY (REQUIRED) ==========
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ========== BUSINESS RULES ==========
GST_PERCENTAGE=18.0
MIN_ORDER_AMOUNT=100.0
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,tiff,ai,psd,eps,cdr
UPLOAD_DIR=uploads

# ========== REDIS (Optional) ==========
REDIS_URL=

# ========== SECURITY ==========
AUTO_CREATE_SCHEMA_ON_STARTUP=false
TRUSTED_HOSTS=*

# ========== OPTIONAL: EMAIL ==========
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ========== OPTIONAL: MONITORING ==========
SENTRY_DSN=
